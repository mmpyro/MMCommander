<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <targets>
    <target xsi:type="File" name="fileLogger" archiveAboveSize="10485760" archiveEvery="Day" maxArchiveFiles="7"
            keepFileOpen="false" fileName="${tempdir}/mmcommander/log.txt" layout="${date}|${level}| ${message}"/>
  </targets>

  <rules>
    <logger name="*" minlevel="Debug" writeTo="fileLogger" />
  </rules>
</nlog>
