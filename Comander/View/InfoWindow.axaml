<view:HidenWindowBase x:Class="Comander.View.InfoWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:view="clr-namespace:Comander.View"
        Title="Info" Height="135" Width="320">
    <Grid ColumnDefinitions="*,2*" RowDefinitions="*,*,*,*,*" Margin="10,5">
        <TextBlock Text="Create time:" Grid.Row="0"/>
        <TextBlock Text="Modify time:" Grid.Row="1"/>
        <TextBlock Text="Access time:" Grid.Row="2"/>
        <TextBlock Text="Attributes:" Grid.Row="3"/>
        <TextBlock Text="Permissions:" Grid.Row="4" IsVisible="{Binding Permissions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        <TextBlock Text="{Binding File.CreationTime}" Grid.Column="1" Grid.Row="0"/>
        <TextBlock Text="{Binding File.LastModifyTime}" Grid.Column="1" Grid.Row="1"/>
        <TextBlock Text="{Binding File.LastAccessTime}" Grid.Column="1" Grid.Row="2"/>
        <TextBlock Text="{Binding AttributesText}" Grid.Column="1" Grid.Row="3"/>
        <TextBlock Text="{Binding Permissions}" Grid.Column="1" Grid.Row="4" Classes="mono"
                   IsVisible="{Binding Permissions, Converter={x:Static ObjectConverters.IsNotNull}}"/>
    </Grid>
</view:HidenWindowBase>
