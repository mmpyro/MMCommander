<UserControl x:Class="Search.View.SearchPage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="*,Auto,Auto">
        <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DoubleTapped="Select_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding FullName}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,4">
            <Button HorizontalAlignment="Stretch" IsEnabled="{Binding IsRunning}" Command="{Binding StopCommand}" Content="Stop"/>
            <Button HorizontalAlignment="Stretch" IsEnabled="{Binding !IsRunning}" Command="{Binding StartCommand}" Content="Search"/>
            <Button HorizontalAlignment="Stretch" Content="Back" Command="{Binding NavigationCommand}"/>
            <Button HorizontalAlignment="Stretch" Content="Select" Command="{Binding SelectCommand}"/>
        </UniformGrid>
        <TextBlock Grid.Row="2" Text="{Binding Status, Mode=OneWay}"/>
    </Grid>
</UserControl>
