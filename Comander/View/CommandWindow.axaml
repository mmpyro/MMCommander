<UserControl x:Class="Comander.View.CommandWindow"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
    </UserControl.Styles>
    <StackPanel>
        <Grid ColumnDefinitions="*,3*">
            <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Drives}" SelectedItem="{Binding DriveLetter}"/>
            <TextBox Grid.Column="1" Text="{Binding ActualPath}"/>
        </Grid>
        <TextBox IsReadOnly="True" Text="{Binding SelectedFile.FullName, Converter={StaticResource FileNameConverter}, Mode=OneWay}"/>
        <StackPanel Orientation="Horizontal">
            <ToggleButton Name="ToolBarToggle" Content="ToolBar" VerticalAlignment="Center" Margin="2"/>
            <Button Classes="tool" ToolTip.Tip="Root directory" Command="{Binding RootDirCommand}">
                <Image Source="/Icons/rootdir.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Choose directory" Command="{Binding ChooseDirCommand}">
                <Image Source="/Icons/dir.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Parent directory" Command="{Binding ParentDirCommand}">
                <Image Source="/Icons/back.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="History" Command="{Binding HistoryCommand}">
                <Image Source="/Icons/refresh.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Shortcuts" Command="{Binding ShowSortcutsCommand}">
                <Image Source="/Icons/icon.png"/>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" IsVisible="{Binding #ToolBarToggle.IsChecked}">
            <Button Classes="tool" ToolTip.Tip="Delete file|directory" Command="{Binding DeleteFileCommand}">
                <Image Source="/Icons/delete.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Move file|directory" Command="{Binding MoveCommand}">
                <Image Source="/Icons/move2.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Copy file|directory" Command="{Binding CopyCommand}">
                <Image Source="/Icons/move.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Create directory" Command="{Binding CreateDirCommand}">
                <Image Source="/Icons/createdir.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Create file" Command="{Binding CreateFileCommand}">
                <Image Source="/Icons/createfile.png"/>
            </Button>
            <Button Classes="tool" ToolTip.Tip="Copy from Clipboard" Command="{Binding PasteToClipboardCommand}">
                <Image Source="/Icons/clipboard.png"/>
            </Button>
        </StackPanel>
        <TextBox BorderBrush="{StaticResource MainBorderBrush}" BorderThickness="2" PlaceholderText="Filter, e.g. ext == txt" Text="{Binding Filter}"/>
    </StackPanel>
</UserControl>
