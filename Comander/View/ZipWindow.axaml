<Window x:Class="Comander.View.ZipWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zip" Icon="/Icons/icon.png" Height="280" Width="420" CanResize="False" WindowStartupLocation="CenterOwner">
    <Grid ColumnDefinitions="140,*,50" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="10">
        <Grid.Styles>
            <Style Selector="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
            <Style Selector="Grid > Control"><Setter Property="Margin" Value="0,0,0,6"/></Style>
        </Grid.Styles>
        <TextBlock Text="Archive name:"/>
        <TextBox Grid.Column="1" Grid.ColumnSpan="2" Name="ArchiveNameTextBox" TextChanged="ArchiveNameTextBox_OnTextChanged"/>
        <TextBlock Grid.Row="1" Text="Destination:"/>
        <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Name="ArchivePathTextBox"/>
        <Button Grid.Row="1" Grid.Column="2" Content="..." Click="Browse_OnClick"/>
        <TextBlock Grid.Row="2" Text="Password:"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Name="PasswordBox" PasswordChar="*"/>
        <TextBlock Grid.Row="3" Text="Confirm password:"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="PasswordBox1" PasswordChar="*"/>
        <TextBlock Grid.Row="4" Text="Type:"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Name="TypeBox" HorizontalAlignment="Stretch"/>
        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Name="StatusTextBlock" Foreground="Red" TextWrapping="Wrap"/>
        <Button Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Name="ExecuteButton" Content="Execute" IsEnabled="False" Click="Execute_OnClick"/>
    </Grid>
</Window>
