<Window x:Class="Comander.View.UnZipWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnZip" Icon="/Icons/icon.png" Height="200" Width="380" CanResize="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10" Spacing="6">
        <RadioButton Name="ExtractHereRadio" IsChecked="True" Content="Extract here" GroupName="target"/>
        <RadioButton Name="ExtractDirRadio" GroupName="target"/>
        <Grid ColumnDefinitions="100,*">
            <TextBlock Text="Password:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" Name="PasswordBox" PasswordChar="*" PlaceholderText="only for encrypted archives"/>
        </Grid>
        <Button Name="ExecuteButton" HorizontalAlignment="Right" Content="Execute" IsDefault="True" Click="Execute_OnClick"/>
    </StackPanel>
</Window>
