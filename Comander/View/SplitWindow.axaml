<local:DialogWindow x:Class="Comander.View.SplitWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Comander.View"
                    Title="Split file" Width="500" SizeToContent="Height">
    <StackPanel Margin="18" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="Split file"/>
            <TextBlock Classes="muted" Text="Cuts a file into parts of a fixed size"/>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Classes="muted" FontSize="12" Text="File to split"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Name="SplitPathTextBox" IsReadOnly="True" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                <Button Grid.Column="1" Content="Browse…" Click="BrowseButton1_OnClick"/>
            </Grid>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Classes="muted" FontSize="12" Text="Part size"/>
            <Grid ColumnDefinitions="*,90" ColumnSpacing="6">
                <TextBox Name="NumericTextBox" FontFamily="{DynamicResource Font.Mono}" FontSize="12" TextChanged="PartSize_OnTextChanged"/>
                <ComboBox Grid.Column="1" Name="UnitComboBox" HorizontalAlignment="Stretch" SelectionChanged="UnitComboBox_OnSelectionChanged"/>
            </Grid>
        </StackPanel>
        <StackPanel Spacing="6">
            <TextBlock Classes="muted" FontSize="12" Text="Destination"/>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox Name="PathTextBox" IsReadOnly="True" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
                <Button Grid.Column="1" Content="Browse…" Click="BrowseButton_OnClick"/>
            </Grid>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Name="FileSizeTextBlock" Classes="muted" FontSize="12"/>
            <TextBlock Name="PartsTextBlock" Classes="muted" FontSize="12"/>
        </StackPanel>
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="footer" Content="Cancel" Click="Cancel_OnClick"/>
                <Button Name="ExecuteButton" Classes="footer accent" Content="Split" IsDefault="True" IsEnabled="False" Click="ExecuteButton_OnClick"/>
            </StackPanel>
            <TextBlock Name="StatusBlock" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
        </DockPanel>
    </StackPanel>
</local:DialogWindow>
