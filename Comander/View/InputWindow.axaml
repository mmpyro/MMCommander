<local:DialogWindow x:Class="Comander.View.InputWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Comander.View"
                    Title="Input" Width="420" SizeToContent="Height">
    <!-- New folder / New file / Rename: Enter returns the text, Esc returns null. -->
    <StackPanel Margin="18" Spacing="14">
        <TextBlock Name="InfoTextBlock" Classes="title"/>
        <TextBox Name="InputTextBox" FontFamily="{DynamicResource Font.Mono}" FontSize="12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="footer" Content="Cancel" IsCancel="True" Click="CancelButton_OnClick"/>
            <Button Classes="footer accent" Content="OK" IsDefault="True" Click="AcceptButton_OnClick"/>
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
