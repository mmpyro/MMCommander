<Window x:Class="Comander.View.ShortcutsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcuts" Icon="/Icons/icon.png" Height="300" Width="300" WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto,Auto">
        <ListBox Name="ListView" DoubleTapped="SelectButton_OnClick"/>
        <Button Click="RemoveButton_OnClick" Content="Remove" Foreground="Red" Grid.Row="1" HorizontalAlignment="Stretch"/>
        <Button Click="SelectButton_OnClick" Content="Select" Grid.Row="2" HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
