<local:DialogWindow x:Class="Comander.View.OverrideWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Comander.View"
        Title="File exists" Height="200" Width="420">
    <Grid RowDefinitions="*,Auto" ColumnDefinitions="Auto,*" Margin="10">
        <Image Name="Image" Width="40" Height="40" Margin="0,0,10,0"/>
        <TextBlock Name="InfoTextBlock" Grid.Column="1" TextWrapping="Wrap" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center"/>
        <UniformGrid Grid.Row="1" Grid.ColumnSpan="2" Columns="2">
            <Button HorizontalAlignment="Stretch" Margin="2" Content="Override all files" Click="OverrideAllButtonClick"/>
            <Button HorizontalAlignment="Stretch" Margin="2" Content="Don't override conflicted" Click="DotNotOverrideButtonClick"/>
            <Button HorizontalAlignment="Stretch" Margin="2" Content="Override single file" Click="OverrideSingleButtonClick"/>
            <Button HorizontalAlignment="Stretch" Margin="2" Content="Cancel" IsCancel="True" Click="CancelButton_OnClick"/>
        </UniformGrid>
    </Grid>
</local:DialogWindow>
