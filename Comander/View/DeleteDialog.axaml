<local:DialogWindow x:Class="Comander.View.DeleteDialog"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Comander.View"
                    Width="520" SizeToContent="Height">
    <!-- docs/design/DeleteDialog.dc.html. Enter confirms, Esc cancels. -->
    <StackPanel Margin="18" Spacing="14">
        <StackPanel Spacing="4">
            <TextBlock Name="TitleText" Classes="title"/>
            <TextBlock Name="SubtitleText" Classes="muted mono" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Background="{DynamicResource Brush.Bg.Input}" CornerRadius="{DynamicResource Radius.Button}" Padding="10,6">
            <ItemsControl Name="ItemList" MaxHeight="180">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" Classes="muted mono" Text="{Binding SizeText}"/>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <ListBox Name="ModeList" Classes="seg">
            <ListBoxItem Name="TrashItem"><TextBlock Text="Move to Trash"/></ListBoxItem>
            <ListBoxItem><TextBlock Text="Delete permanently"/></ListBoxItem>
        </ListBox>
        <TextBlock Name="HintText" TextWrapping="Wrap"/>
        <CheckBox Name="DontAskBox" Content="Don't ask again when moving to Trash"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Name="CancelButton" Classes="footer" Content="Cancel  Esc"/>
            <Button Name="OkButton" Classes="footer accent" IsDefault="True"><TextBlock Name="OkText"/></Button>
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
